<Project Sdk="Microsoft.NET.Sdk">

  <!-- The .NET compatibility suite (plan step N1, Implementation Strategy §57-58, RFC 0015 §1): an ordinary portable
       console application with nothing for WitOS, run unchanged on Windows, Linux and WitOS. Each area checks the
       standard semantics of its APIs; expectations.json records, per platform, the intended differences. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DotNetCompatibility</AssemblyName>
    <RootNamespace>DotNetCompatibility</RootNamespace>
  </PropertyGroup>

  <!-- The runtime's diagnostic IPC as dotnet-counters and dotnet-trace reach it (the Ipc area, W4.1). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
  </ItemGroup>

  <ItemGroup>
    <None Include="expectations.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
