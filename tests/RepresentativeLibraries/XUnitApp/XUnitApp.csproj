<Project Sdk="Microsoft.NET.Sdk">

  <!-- Representative libraries under xUnit (plan step N2.1, Implementation Strategy §59): an ordinary xUnit v3 test
       application from nuget.org packages, which runs its own tests as dotnet XUnitApp.dll on Windows, Linux and WitOS,
       nothing for WitOS. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>XUnitApp</AssemblyName>
    <RootNamespace>RepresentativeLibraries</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
