<Project Sdk="Microsoft.NET.Sdk">

  <!-- The application of the side-by-side scenario (plan step N3.3): built by the stock SDK once for .NET 8 and once
       for .NET 10, each against that release's reference pack, with nothing for WitOS; the guest's dotnet picks each
       build's framework by the runtimeconfig the tool writes beside it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>App</AssemblyName>
    <RootNamespace>App</RootNamespace>
    <UseAppHost>false</UseAppHost>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
