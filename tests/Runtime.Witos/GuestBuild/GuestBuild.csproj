<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console project the .NET SDK of the data volume's layer builds in the guest (plan step E4.4): laid on the volume
       as its source alone, built by dotnet build there with no network, then run by dotnet. No apphost, which no feed
       offers WitOS in the guest, and no package from NuGet. The host never builds it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
