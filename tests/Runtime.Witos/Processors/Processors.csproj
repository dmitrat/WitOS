<Project Sdk="Microsoft.NET.Sdk">

  <!-- An ordinary console application (plan step P2) that checks what a program sees of several processors: the
       processor count, the processors its threads run on, the garbage collector's heaps and the thread pool, under work
       on every processor. Framework-dependent and portable, with nothing for WitOS; published once as it is and once
       with ServerGarbageCollection, as an application selects the server collector. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Processors</AssemblyName>
  </PropertyGroup>

</Project>
