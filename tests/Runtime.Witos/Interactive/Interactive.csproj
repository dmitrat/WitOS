<Project Sdk="Microsoft.NET.Sdk">

  <!-- An ordinary interactive console application (plan step E4.2): published by the stock SDK without a RID, laid on a
       USB drive, copied by Arlecchino.Commander to the data volume and run from its command line under the
       pseudo-terminal of E4.1; it asks a question answered with a line, then holds the whole screen until a key. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Interactive</AssemblyName>
  </PropertyGroup>

</Project>
