<Project Sdk="Microsoft.NET.Sdk">

  <!-- An ordinary console application (plan step R6): what Visual Studio's template gives, framework-dependent and
       portable, with nothing for WitOS. dotnet publish without a RID builds it; the guest runs it unchanged. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PortableApp</AssemblyName>
  </PropertyGroup>

</Project>
