<Project Sdk="Microsoft.NET.Sdk">

  <!-- An ordinary console application (plan step E2.2): published by the stock SDK without a RID, run beside a share of an
       SMB server that witos-volumes mounted below /media; it uses the share through System.IO as any program uses a
       directory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Share</AssemblyName>
  </PropertyGroup>

</Project>
