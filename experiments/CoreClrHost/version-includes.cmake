# Version metadata generated by the upstream MSBuild target for this profile.
# Keep the shared CoreCLR/NativeAOT reference obj directory unchanged.
function(witos_host_reference_versions directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(kind "${target}" TYPE)
    if(kind STREQUAL "INTERFACE_LIBRARY")
      target_include_directories("${target}" BEFORE INTERFACE "${WITOS_HOST_VERSION_DIR}")
    elseif(NOT kind STREQUAL "UTILITY")
      target_include_directories("${target}" BEFORE PRIVATE "${WITOS_HOST_VERSION_DIR}")
    endif()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    witos_host_reference_versions("${child}")
  endforeach()
endfunction()
cmake_language(DEFER CALL witos_host_reference_versions "${CMAKE_SOURCE_DIR}")
