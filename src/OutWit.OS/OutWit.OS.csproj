<Project Sdk="Microsoft.NET.Sdk">
  <!-- The managed capability API of WitOS's own services (plan step D1.1, ADR 0025): libwitos through direct P/Invoke
       in NativeAOT. runtime-witos compiles these sources into each service it publishes for witos; on the host the
       project builds and its parsing is tested. Not published, not an application API until phase N. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>OutWit.OS</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OutWit.OS.Tests" />
    <!-- The runner's SMB server writes the NT hash of its account's password (E2.2). -->
    <InternalsVisibleTo Include="WitOS.Dev" />
  </ItemGroup>
  <ItemGroup>
    <!-- FAT through the independent OutWit library, reached by FileSystems/Fat alone (storage document §14-15, plan step
         D4.1); a service that compiles that folder takes this reference too (RuntimeDevices). -->
    <PackageReference Include="OutWit.Common.Fat" Version="1.0.0" />
  </ItemGroup>
</Project>
