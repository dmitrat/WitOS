<Project Sdk="Microsoft.NET.Sdk">
  <!-- The network service (plan step W1.2a, W0's decisions 2 and 4): the NativeAOT program /system/Network of the boot
       package, which the device manager starts with the adapters' packet channels it moves to it; it runs the managed
       TCP/IP stack (OutWit.OS.Networking) over them and serves sockets to every process. runtime-witos publishes it for
       witos with the OutWit.OS sources; on the host the project builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Network</AssemblyName>
    <RootNamespace>OutWit.OS.Network</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../OutWit.OS/OutWit.OS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OutWit.OS.Tests" />
  </ItemGroup>
</Project>
