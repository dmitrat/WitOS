<Project Sdk="Microsoft.NET.Sdk">
  <!-- The virtio input driver (plan step C2.1, ADR 0025): the NativeAOT program /system/Drivers/VirtioInput of the boot
       package, which the device manager starts with the device it moves to it; it drives a virtio keyboard and reports
       its events, which the display's terminal takes from C2.2. runtime-witos publishes it for witos with the OutWit.OS
       sources; on the host the project builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>VirtioInput</AssemblyName>
    <RootNamespace>OutWit.OS.Drivers.VirtioInput</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../OutWit.OS/OutWit.OS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OutWit.OS.Tests" />
  </ItemGroup>
</Project>
