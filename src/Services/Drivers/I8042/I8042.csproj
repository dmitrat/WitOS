<Project Sdk="Microsoft.NET.Sdk">
  <!-- The PC's PS/2 keyboard driver (plan step H5.2, ADR 0031): the NativeAOT program /system/Drivers/I8042 of the boot
       package, which the device manager starts with the i8042 it moves to it; it serves the keyboard's keys on the input
       protocol, which the display's terminal takes. runtime-witos publishes it for witos with the OutWit.OS sources; on
       the host the project builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>I8042</AssemblyName>
    <RootNamespace>OutWit.OS.Drivers.I8042</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../OutWit.OS/OutWit.OS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OutWit.OS.Tests" />
  </ItemGroup>
</Project>
