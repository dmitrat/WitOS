<Project Sdk="Microsoft.NET.Sdk">
  <!-- The virtio console driver (plan step N4.3a, ADR 0025): the NativeAOT program /system/Drivers/VirtioConsole of
       the boot package, which the device manager starts with the device it moves to it; it serves the serial protocol
       (witos/serial.h) to the terminal service. runtime-witos publishes it for witos with the OutWit.OS sources; on the
       host the project builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>VirtioConsole</AssemblyName>
    <RootNamespace>OutWit.OS.Drivers.VirtioConsole</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../OutWit.OS/OutWit.OS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OutWit.OS.Tests" />
  </ItemGroup>
</Project>
