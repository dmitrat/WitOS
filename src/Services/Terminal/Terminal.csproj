<Project Sdk="Microsoft.NET.Sdk">
  <!-- The terminal service (plan step N4.3, RFC 0020 sections 6 and 8): the NativeAOT program /system/Terminal of the
       boot package, which the device manager starts with the console driver's serial channel; it owns the line
       discipline and serves the terminal protocol (witos/terminal.h) to every process. runtime-witos publishes it for
       witos with the OutWit.OS sources; on the host the project builds and its discipline is tested. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Terminal</AssemblyName>
    <RootNamespace>OutWit.OS.Terminal</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../OutWit.OS/OutWit.OS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OutWit.OS.Tests" />
  </ItemGroup>
</Project>
