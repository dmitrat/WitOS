<Project Sdk="Microsoft.NET.Sdk">
  <!-- The display service (plan step C2.2, RFC 0020 section 28, RFC 0009 section 26): the NativeAOT program
       /system/Display of the boot package, which the device manager starts with the firmware's framebuffer and the
       keyboard driver's channel; it draws a terminal screen into the framebuffer with a bitmap font and serves the serial
       protocol (witos/serial.h) to the terminal service as the virtio console driver does. runtime-witos publishes it for
       witos with the OutWit.OS sources; on the host the project builds and its parts are tested. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Display</AssemblyName>
    <RootNamespace>OutWit.OS.DisplayService</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../OutWit.OS/OutWit.OS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OutWit.OS.Tests" />
  </ItemGroup>
</Project>
