<Project Sdk="Microsoft.NET.Sdk">
  <!-- The time service (plan step H7.4): the NativeAOT program /system/Time of the boot package, which the root task
       starts after the device manager with the clock capability; on a board without a real-time clock it sets UTC to the
       time it saved on /data, asks the time servers the package names over SNTP, and saves the time again as it stops.
       runtime-witos publishes it for witos with the OutWit.OS sources; on the host the project builds and its parts are
       tested. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Time</AssemblyName>
    <RootNamespace>OutWit.OS.Time</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../OutWit.OS/OutWit.OS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OutWit.OS.Tests" />
  </ItemGroup>
</Project>
