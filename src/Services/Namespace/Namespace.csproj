<Project Sdk="Microsoft.NET.Sdk">
  <!-- The namespace service (plan step D5.1, storage document section 21): the NativeAOT program /system/Namespace of
       the boot package, which the device manager starts with the disks it moves to it; it mounts their volumes and
       serves their files to every process. runtime-witos publishes it for witos with the OutWit.OS sources; on the host
       the project builds and its sessions are tested. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Namespace</AssemblyName>
    <RootNamespace>OutWit.OS.Namespace</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../OutWit.OS/OutWit.OS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OutWit.OS.Tests" />
  </ItemGroup>
</Project>
