* text=auto
*.asm text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.cmake text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.md text eol=lf whitespace=-blank-at-eol
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
*.json text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.props text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
# The console mark and the profile reach the guest as the package's bytes (C1.4): one line ending on every host.
build/console/** text eol=lf
