+		# interesting case: 0x1p-32 <= |x| < 0x1p15
+		# check if (exponent|0x8000) is in [0xbfff-32, 0xbfff+14]
 	mov 16(%rsp), %ax
 	or $0x8000, %ax
-	sub $0xbfdf, %ax
-	cmp $45, %ax
+	sub $0xbfe0, %ax
