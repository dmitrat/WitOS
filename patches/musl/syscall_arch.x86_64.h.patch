 #define __SYSCALL_LL_E(x) (x)
 #define __SYSCALL_LL_O(x) (x)
 
+/* WitOS (plan step S1.1): the Linux instruction gives way to the system layer's dispatch over ABI-1
+ * (src/Substrate/libc/syscall.c), which returns the Linux convention; there is no vDSO. */
+__attribute__((__visibility__("hidden"))) long __wit_syscall(long, long, long, long, long, long, long);
+
 static __inline long __syscall0(long n)
 {
-	unsigned long ret;
-	__asm__ __volatile__ ("syscall" : "=a"(ret) : "a"(n) : "rcx", "r11", "memory");
-	return ret;
+	return __wit_syscall(n, 0, 0, 0, 0, 0, 0);
 }
 
