After: b1d9095501333660d6ba72b34ce0761461563e8f71e2ea218859783dcb33aae6

The cross toolchain for witos (plan step R1.2b): the system layer's sysroot is recognized by its marker
etc/witos-release, as FreeBSD's rootfs is by bin/freebsd-version. CMake's system is WitOS, whose platform modules the
sysroot carries; clang builds for the layer-2 triples against the sysroot and its own resource directory, C++ links
libc++ through the existing CLR_CMAKE_CXX_STANDARD_LIBRARY knob, and lld links against compiler-rt and libunwind with 4
KiB pages and separate loadable segments, the layout WitOS's loader maps.

--- a/eng/common/cross/toolchain.cmake
+++ b/eng/common/cross/toolchain.cmake
@@ -8,6 +8,7 @@
 unset(ANDROID)
 unset(TIZEN)
 unset(HAIKU)
+unset(WITOS)
 
 set(TARGET_ARCH_NAME $ENV{TARGET_BUILD_ARCH})
 
@@ -25,6 +26,11 @@
 elseif(EXISTS ${CROSS_ROOTFS}/boot/system/develop/headers/config/HaikuConfig.h)
   set(CMAKE_SYSTEM_NAME Haiku)
   set(HAIKU 1)
+elseif(EXISTS ${CROSS_ROOTFS}/etc/witos-release)
+  # WitOS's sysroot carries CMake's platform modules for the system (ELF with the Linux compiler rules).
+  set(CMAKE_SYSTEM_NAME WitOS)
+  list(APPEND CMAKE_MODULE_PATH "${CROSS_ROOTFS}/usr/share/cmake")
+  set(WITOS 1)
 else()
   set(CMAKE_SYSTEM_NAME Linux)
   set(LINUX 1)
@@ -137,6 +143,19 @@
   endif()
 else()
   message(FATAL_ERROR "Arch is ${TARGET_ARCH_NAME}. Only arm, arm64, armel, armv6, loongarch64, ppc64le, riscv64, s390x, x64 and x86 are supported!")
+endif()
+
+if(WITOS)
+  # The layer-2 triples (until WitOS has its own): clang builds for them against the sysroot.
+  if(TARGET_ARCH_NAME STREQUAL "arm64")
+    set(TOOLCHAIN "aarch64-unknown-linux-musl")
+  elseif(TARGET_ARCH_NAME STREQUAL "x64")
+    set(TOOLCHAIN "x86_64-unknown-linux-musl")
+  elseif(TARGET_ARCH_NAME STREQUAL "riscv64")
+    set(TOOLCHAIN "riscv64-unknown-linux-musl")
+  else()
+    message(FATAL_ERROR "WitOS has no ${TARGET_ARCH_NAME} system layer.")
+  endif()
 endif()
 
 if(DEFINED ENV{TOOLCHAIN})
@@ -220,6 +239,13 @@
 
     locate_toolchain_exec(gcc CMAKE_C_COMPILER)
     locate_toolchain_exec(g++ CMAKE_CXX_COMPILER)
+elseif(WITOS)
+    # The sysroot holds musl, libc++ (C++ links it through the knob below) and compiler-rt, the last in the sysroot's
+    # own resource directory.
+    set(CMAKE_SYSROOT "${CROSS_ROOTFS}")
+    file(GLOB WITOS_RESOURCE_DIR "${CROSS_ROOTFS}/usr/lib/clang/*")
+    add_compile_options(-resource-dir=${WITOS_RESOURCE_DIR})
+    set(CLR_CMAKE_CXX_STANDARD_LIBRARY "libc++" CACHE STRING "Standard library flavor to link against. Only supported with the Clang compiler.")
 elseif(HAIKU)
     set(CMAKE_SYSROOT "${CROSS_ROOTFS}")
     set(CMAKE_SYSTEM_PREFIX_PATH "${CROSS_ROOTFS}")
@@ -301,6 +327,16 @@
 elseif(HAIKU)
   add_toolchain_linker_flag("-lnetwork")
   add_toolchain_linker_flag("-lroot")
+endif()
+
+if(WITOS)
+  # lld links against the sysroot's compiler-rt and libunwind in the page layout WitOS's loader maps.
+  add_toolchain_linker_flag("-resource-dir=${WITOS_RESOURCE_DIR}")
+  add_toolchain_linker_flag("--rtlib=compiler-rt")
+  add_toolchain_linker_flag("--unwindlib=libunwind")
+  add_toolchain_linker_flag("-fuse-ld=lld")
+  add_toolchain_linker_flag("-Wl,-z,max-page-size=4096")
+  add_toolchain_linker_flag("-Wl,-z,separate-loadable-segments")
 endif()
 
 # Specify compile options
