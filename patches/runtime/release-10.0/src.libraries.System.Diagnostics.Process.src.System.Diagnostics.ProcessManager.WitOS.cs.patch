+using System.Collections.Generic;
+using System.IO;
+
+namespace System.Diagnostics
+{
+    // WitOS (TargetOS=witos): there is no /proc and no call that lists processes, so the processes are not enumerated
+    // and no process but the current one has a record; its name and its one module come from Environment.ProcessPath,
+    // the path its creator started it by.
+    internal static partial class ProcessManager
+    {
+        /// <summary>Gets the IDs of all processes on the current machine.</summary>
+        public static int[] GetProcessIds()
+        {
+            throw new PlatformNotSupportedException();
+        }
+
+        /// <summary>Gets process infos for each process on the specified machine.</summary>
+        /// <param name="processNameFilter">Optional process name to use as an inclusion filter.</param>
+        /// <param name="machineName">The target machine.</param>
+        /// <returns>An array of process infos, one per found process.</returns>
+        public static ProcessInfo[] GetProcessInfos(string? processNameFilter, string machineName)
+        {
+            ThrowIfRemoteMachine(machineName);
+            throw new PlatformNotSupportedException();
+        }
+
+        /// <summary>Gets an array of module infos for the specified process.</summary>
+        /// <param name="processId">The ID of the process whose modules should be enumerated.</param>
+        /// <returns>The array of modules: the current process's program, nothing of another process.</returns>
+        internal static ProcessModuleCollection GetModules(int processId)
+        {
+            string? path = processId == Environment.ProcessId ? Environment.ProcessPath : null;
+            if (!string.IsNullOrEmpty(path))
+            {
+                return new ProcessModuleCollection(1)
+                {
+                    new ProcessModule(path, Path.GetFileName(path))
+                };
+            }
+
+            return new ProcessModuleCollection(0);
+        }
+
+        internal static ProcessInfo? CreateProcessInfo(int pid, string? processNameFilter = null)
+        {
+            ArgumentOutOfRangeException.ThrowIfNegative(pid);
+
+            if (pid != Environment.ProcessId)
+            {
+                return null; // no record of another process: its name and figures are not there
+            }
+
+            string name = Path.GetFileName(Environment.ProcessPath) ?? string.Empty;
+            if (!string.IsNullOrEmpty(processNameFilter) && !processNameFilter.Equals(name))
+            {
+                return null;
+            }
+
+            return new ProcessInfo()
+            {
+                ProcessId = pid,
+                ProcessName = name,
+                SessionId = 0,
+            };
+        }
+    }
+}
