The native libraries on witos (plan steps R1.2b, R2.1 and W3.1, RFC 0015 section 8): WitOS has no GSSAPI, so
System.Net.Security.Native is not built and Negotiate authentication fails explicitly; System.Security.Cryptography.Native
is built as on Linux against the OpenSSL the system layer builds from its pinned release, and the portable shim opens
libssl.so.3 and libcrypto.so.3 from the install's /usr/lib at run time. _GNU_SOURCE is defined as on Linux and Haiku:
the system layer's libc is musl, which declares its GNU functions (sched_getaffinity, struct ucred and the rest) only
under it, and System.Native does not build without them.

--- a/src/native/libs/CMakeLists.txt
+++ b/src/native/libs/CMakeLists.txt
@@ -102,7 +102,7 @@
         add_definitions(-D__APPLE_USE_RFC_3542)
     endif ()
 
-    if (CLR_CMAKE_TARGET_LINUX OR CLR_CMAKE_TARGET_HAIKU)
+    if (CLR_CMAKE_TARGET_LINUX OR CLR_CMAKE_TARGET_HAIKU OR CLR_CMAKE_TARGET_WITOS)
         set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -D_GNU_SOURCE")
     endif ()
 else ()
@@ -156,6 +156,10 @@
         endif ()
 
         add_subdirectory(System.Security.Cryptography.Native.Apple)
+    elseif (CLR_CMAKE_TARGET_WITOS)
+        # WitOS has no GSSAPI: Negotiate authentication refuses explicitly. Cryptography and TLS go through the OpenSSL
+        # the system layer builds from its pinned release (plan step W3.1), which the shim opens at run time.
+        add_subdirectory(System.Security.Cryptography.Native)
     elseif (CLR_CMAKE_TARGET_ANDROID AND NOT FORCE_ANDROID_OPENSSL)
