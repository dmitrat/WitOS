+    // Set the maximum double mapped memory size to the size of the physical memory
+    long pages = sysconf(_SC_PHYS_PAGES);
+    if (pages != -1)
+    {
+        long pageSize = sysconf(_SC_PAGE_SIZE);
+        if (pageSize != -1)
+        {
+            uint64_t physicalMemorySize = (uint64_t)pages * pageSize;
