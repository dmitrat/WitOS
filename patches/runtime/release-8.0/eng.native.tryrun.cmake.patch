The configure's try_run answers for witos on release/8.0 (plan step N3.2): the sysroot is recognized by its
marker, and the answers are the guest's, which runtime-side-by-side measures for 8.0's probes as runtime-witos does
for 10.0's.

--- a/eng/native/tryrun.cmake
+++ b/eng/native/tryrun.cmake
@@ -45,6 +45,8 @@
 elseif(EXISTS ${CROSS_ROOTFS}/boot/system/develop/headers/config/HaikuConfig.h)
   set(HAIKU 1)
   set(CLR_CMAKE_TARGET_OS haiku)
+elseif(EXISTS ${CROSS_ROOTFS}/etc/witos-release)
+  set(WITOS 1)
 endif()
 
 if(DARWIN)
@@ -175,3 +177,30 @@
 elseif (TARGET_ARCH_NAME STREQUAL "riscv64")
