The platform variables for witos on release/8.0 (plan step N3.2): the host and the target are Unix and
witos, x64 or ARM64, as on 10.0.

--- a/eng/native/configureplatform.cmake
+++ b/eng/native/configureplatform.cmake
@@ -211,6 +211,18 @@
     set(CLR_CMAKE_HOST_HAIKU 1)
 endif(CLR_CMAKE_HOST_OS STREQUAL haiku)
 
+if(CLR_CMAKE_HOST_OS STREQUAL witos)
+    set(CLR_CMAKE_HOST_UNIX 1)
+    if(CMAKE_SYSTEM_PROCESSOR STREQUAL x86_64)
+        set(CLR_CMAKE_HOST_UNIX_AMD64 1)
+    elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL aarch64)
+        set(CLR_CMAKE_HOST_UNIX_ARM64 1)
+    else()
+        clr_unknown_arch()
+    endif()
+    set(CLR_CMAKE_HOST_WITOS 1)
+endif(CLR_CMAKE_HOST_OS STREQUAL witos)
+
 if(CLR_CMAKE_HOST_OS STREQUAL windows)
     set(CLR_CMAKE_HOST_WIN32 1)
 endif(CLR_CMAKE_HOST_OS STREQUAL windows)
@@ -421,6 +433,11 @@
     set(CLR_CMAKE_TARGET_HAIKU 1)
 endif(CLR_CMAKE_TARGET_OS STREQUAL haiku)
 
+if(CLR_CMAKE_TARGET_OS STREQUAL witos)
+    set(CLR_CMAKE_TARGET_UNIX 1)
+    set(CLR_CMAKE_TARGET_WITOS 1)
+endif(CLR_CMAKE_TARGET_OS STREQUAL witos)
+
 if(CLR_CMAKE_TARGET_OS STREQUAL emscripten)
     set(CLR_CMAKE_TARGET_UNIX 1)
     set(CLR_CMAKE_TARGET_LINUX 1)
