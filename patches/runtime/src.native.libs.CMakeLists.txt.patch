The native libraries on witos (plan steps R1.2b and R2.1, RFC 0015 section 8): WitOS has no GSSAPI and no OpenSSL, so
System.Net.Security.Native and System.Security.Cryptography.Native are not built; Negotiate authentication and
cryptography fail explicitly until a provider exists. _GNU_SOURCE is defined as on Linux and Haiku: the system layer's
libc is musl, which declares its GNU functions (sched_getaffinity, struct ucred and the rest) only under it, and
System.Native does not build without them.

--- a/src/native/libs/CMakeLists.txt
+++ b/src/native/libs/CMakeLists.txt
@@ -102,7 +102,7 @@
         add_definitions(-D__APPLE_USE_RFC_3542)
     endif ()
 
-    if (CLR_CMAKE_TARGET_LINUX OR CLR_CMAKE_TARGET_HAIKU)
+    if (CLR_CMAKE_TARGET_LINUX OR CLR_CMAKE_TARGET_HAIKU OR CLR_CMAKE_TARGET_WITOS)
         set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -D_GNU_SOURCE")
     endif ()
 else ()
@@ -156,6 +156,9 @@
         endif ()
 
         add_subdirectory(System.Security.Cryptography.Native.Apple)
+    elseif (CLR_CMAKE_TARGET_WITOS)
+        # WitOS has no GSSAPI and no OpenSSL: Negotiate authentication and cryptography refuse explicitly until a
+        # provider exists.
     elseif (CLR_CMAKE_TARGET_ANDROID AND NOT FORCE_ANDROID_OPENSSL)
         add_subdirectory(System.Security.Cryptography.Native.Android)
     elseif (FORCE_ANDROID_OPENSSL)
